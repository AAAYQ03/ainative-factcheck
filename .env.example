# 扶摇金融数据 API Key（https://fuyao.aicubes.cn/admin 签发）
FUYAO_API_KEY=
# DeepSeek API Key（产品运行时调用的 LLM）
DEEPSEEK_API_KEY=
# 可选：覆盖默认模型 / 地址
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# FUYAO_BASE_URL=https://fuyao.aicubes.cn
# 本机 getaddrinfo 解析不了扶摇域名时，用 npm run dev:localdns（不要写进 .env，否则会被打包进 Cloudflare Worker）
